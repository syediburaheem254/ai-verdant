# Copy this file to `.env` and fill in real values. Never commit `.env`.

SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=5000

# Shared secret the ESP32/Arduino must send as the "X-Device-Key" header
DEVICE_API_KEY=replace-with-a-long-random-string

# Google Sheets bridge
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_NAME=AI Farming - Sensor Log
GOOGLE_SHEET_ID=
SHEETS_SYNC_ENABLED=true

# Public URL where this backend is reachable (used to build the QR portal
# and dashboard links). Use your deployed URL or an ngrok tunnel for testing.
PUBLIC_BASE_URL=http://localhost:5000
